{
   libreadline-still-reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libreadline.so*
}

{
   libreadline-definitely-lost
   Memcheck:Leak
   match-leak-kinds: definitely
   ...
   obj:*/libreadline.so*
}

{
   libtinfo-still-reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libtinfo.so*
}

{
   libtinfo-definitely-lost
   Memcheck:Leak
   match-leak-kinds: definitely
   ...
   obj:*/libtinfo.so*
}

{
   libreadline-indirect
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:xmalloc
   obj:*/libreadline.so*
}

{
   libtinfo-indirect
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:_nc_init_keytry
   obj:*/libtinfo.so*
}

